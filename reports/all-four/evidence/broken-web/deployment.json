{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "broken-web",
    "namespace": "triage-lab"
  },
  "spec": {
    "replicas": 1,
    "selector": {
      "matchLabels": {
        "app": "broken-web"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "broken-web"
        }
      },
      "spec": {
        "containers": [
          {
            "name": "web",
            "image": "nginx:99.99-definitely-missing",
            "ports": [
              {
                "containerPort": 80
              }
            ]
          }
        ]
      }
    }
  }
}
