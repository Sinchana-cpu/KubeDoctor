    "get events -n triage-lab --field-selector involvedObject.name=crashy-api-7f9d6c5b8d-q4w8z --sort-by=.lastTimestamp": "before/events-crashy-api.txt",
    "logs crashy-api-7f9d6c5b8d-q4w8z -n triage-lab -c api --tail=50 --previous": "before/logs-crashy-api.txt",
    "get deployment crashy-api -n triage-lab -o json": "before/deployment-crashy-api.json",
    "get pods -n triage-lab -l app=crashy-api -o json": "before/selector-crashy-api.json"
